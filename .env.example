# RepUK environment variable names (safe template — no secret values).
# Copy to `.env.local` for development. Production/preview values live in Vercel.

# --- Core site ---
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
CRON_SECRET=local-dev-placeholder-not-for-production

# --- KV / Upstash (required for registrations, outreach, custody) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Legacy aliases also supported:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# --- Email (Resend) ---
RESEND_API_KEY=
# Webhook signing secret from Resend dashboard / `npm run firm-outreach:configure-resend`
RESEND_WEBHOOK_SECRET=
# Preview deployments enforce allowlist: robertdavidcashman@gmail.com only
PREVIEW_EMAIL_ALLOWLIST=

# --- Outreach automation ---
FIRM_OUTREACH_ENABLED=true
FIRM_OUTREACH_DRY_RUN=0
FIRM_OUTREACH_SEND_ENABLED=true
FIRM_OUTREACH_PAUSED=false
# Auto-send by default. Set true for click-to-send approval emails.
FIRM_OUTREACH_REQUIRE_APPROVAL=false
FIRM_OUTREACH_DAILY_CAP=90
FIRM_OUTREACH_FROM_EMAIL=PoliceStationRepUK <noreply@policestationrepuk.org>
FIRM_OUTREACH_PSA_FROM_EMAIL=Police Station Agent <noreply@policestationagent.com>
FIRM_OUTREACH_DIGEST_EMAIL=
# Required for the consolidated 07:00 Europe/London daily outreach report
# (falls back to FIRM_OUTREACH_DIGEST_EMAIL / BUFFER_SCHEDULER_NOTIFY_EMAIL / OWNER_EMAIL)
OUTREACH_ADMIN_EMAIL=
# Signs Ready-to-send / unsubscribe tokens (falls back to CRON_SECRET)
ADMIN_DECISION_TOKEN_SECRET=
# Legacy aliases (still accepted by validateAutomationEnv):
# FIRM_OUTREACH_WEBHOOK_SECRET=   → prefer RESEND_WEBHOOK_SECRET
# DECISION_TOKEN_SECRET=          → prefer ADMIN_DECISION_TOKEN_SECRET

# --- Buffer scheduler ---
BUFFER_API_KEY=
BUFFER_ORGANIZATION_ID=
BUFFER_CHANNEL_TWITTER_ID=
BUFFER_CHANNEL_LINKEDIN_ID=
BUFFER_CHANNEL_GOOGLEBUSINESS_ID=
# Prefer local-only once siblings self-schedule (avoids double-posting):
# BUFFER_CONTENT_FEEDS=[{"id":"policestationrepuk","type":"local"}]
BUFFER_SCHEDULER_TIMEZONE=Europe/London
BUFFER_SCHEDULER_NOTIFY_EMAIL=

# --- Automation health-check / self-healing (Upstash KV backed) ---
# Safe defaults for first production rollout: dry-run on, auto-repair off.
AUTOMATION_ENABLED=true
AUTOMATION_DRY_RUN=1
AUTOMATION_TIMEZONE=Europe/London
AUTOMATION_ALLOW_NON_PROD=0
DAILY_HEALTHCHECK_ENABLED=true
DAILY_HEALTHCHECK_HOUR=7
WATCHDOG_ENABLED=true
BUFFER_HEALTHCHECK_ENABLED=true
CROSS_SITE_HEALTHCHECK_ENABLED=true
AUTO_REPAIR_ENABLED=0
AUTO_RETRY_ENABLED=1
MAX_RETRY_COUNT=3
STUCK_JOB_TIMEOUT_MINUTES=120
LOCK_TIMEOUT_MINUTES=30
ALERT_REMINDER_HOURS=24
DAILY_SUCCESS_EMAIL_ENABLED=false
AUTOMATION_ALERT_EMAIL=
# Sibling remote gap-fill over HTTPS (off by default). When AUTOMATION_DRY_RUN=0,
# healthcheck forces remote repair anyway. Custodynote uses REPUK promo fallback if
# /api/buffer/schedule returns 404.
CROSS_SITE_REMOTE_REPAIR_ENABLED=0

# --- Custody discovery (see docs/custody-discovery-ops.md) ---
SERPER_API_KEY=
OPENAI_API_KEY=
CUSTODY_DISCOVERY_BATCH_LIMIT=10
CUSTODY_DISCOVERY_MAX_QUERIES=4
CUSTODY_DISCOVERY_PAGE_FETCH_LIMIT=3
CUSTODY_DISCOVERY_MAX_ELAPSED_MS=240000
# Keep AI batch modest — cron already runs once/day; empty backlog skips OpenAI
CUSTODY_AI_BATCH_LIMIT=8
CUSTODY_AI_FETCH_EVIDENCE=true
# ON unless set to false — high-confidence official findings may auto-publish
CUSTODY_AI_AUTO_PUBLISH=true
CUSTODY_AI_AUTO_REJECT=true
CUSTODY_AI_MIN_REJECT_CONFIDENCE=85
CUSTODY_AI_LOW_REJECT_CONFIDENCE=40
CUSTODY_CORROBORATION_MIN_SOURCES=2
CUSTODY_EVIDENCE_RETRY_LIMIT=3
CUSTODY_RECHECK_DAYS=90
CUSTODY_RECHECK_BATCH_LIMIT=20
CUSTODY_DISCOVERY_NOTIFY_EMAIL=
ADMIN_DECISION_TOKEN_SECRET=
# Feature flags for station-contact research expansion (Phase 4–7)
# Keep disabled + dry-run until dry-run comparison report is reviewed.
STATION_RESEARCH_ENABLED=0
STATION_RESEARCH_DRY_RUN=1
STATION_MAINLINE_RESEARCH_ENABLED=0
STATION_RESEARCH_AUTO_PUBLISH=0
STATION_RESEARCH_BATCH_LIMIT=5
STATION_RESEARCH_MAX_QUERIES=3
STATION_RESEARCH_MAX_PAGES=2
# Optional search providers (default: serper via SERPER_API_KEY)
# WEB_SEARCH_PROVIDER=serper
# BRAVE_SEARCH_API_KEY=
# BING_SEARCH_API_KEY=

# --- Supabase (optional local mirror / preview project) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Analytics (Vercel only in production layout) ---
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
